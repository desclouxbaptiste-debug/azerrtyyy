# Copy this file to .env and fill it in. Never commit .env (it holds your secret keys).

# Your domain, already pointing to this server (DNS record A → the server's IP address)
CLIPZO_DOMAIN=clipzo.example.com

# Claude: ranks the moments and writes titles (https://console.anthropic.com → API keys). Optional.
ANTHROPIC_API_KEY=

# Stripe (https://dashboard.stripe.com → Developers). Start with the test keys (sk_test_...).
STRIPE_SECRET_KEY=
# Developers → Webhooks → add endpoint https://<your domain>/api/billing/webhook, then copy its secret
STRIPE_WEBHOOK_SECRET=
# Optional: prices created in the Stripe dashboard. Empty = 5 €/10 € per month, -20 % yearly.
STRIPE_PRICE_CREATOR_MONTH=
STRIPE_PRICE_CREATOR_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=

# Speech-to-text model: small (default, CPU), medium or large-v3 (better, needs a GPU), off
CLIPZO_WHISPER_MODEL=small
# Videos processed at the same time (1 on a 4 GB server)
CLIPZO_WORKERS=1

# Optional: Twitch viewers' clips + automatic import after each live (Pro plan)
# Free application to register at https://dev.twitch.tv/console/apps (README, "Twitch")
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: "your shorts are ready" e-mails through an SMTP server (Brevo, Mailjet, your mailbox...)
CLIPZO_SMTP_HOST=
CLIPZO_SMTP_PORT=587
CLIPZO_SMTP_USER=
CLIPZO_SMTP_PASSWORD=
CLIPZO_SMTP_FROM=

# PostgreSQL connection string (Supabase, Neon, Railway, or your own instance)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Random 32+ character secret used to sign session cookies
# Generate one with: openssl rand -base64 32
SESSION_SECRET=""

# Resend API key used to send confirmation and reminder emails.
# Leave empty in development: emails are logged to the console instead of sent.
RESEND_API_KEY=""
REMINDER_FROM_EMAIL="rappels@votre-domaine.fr"

# Shared secret required in the Authorization header of the cron endpoint
# (Vercel Cron sends it automatically when CRON_SECRET is set).
CRON_SECRET=""

# Public base URL of the app, used to build the booking link shown in the dashboard.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
